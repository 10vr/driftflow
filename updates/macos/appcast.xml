        <item>
            <title>Driftflow 0.2.8</title>
            <pubDate>Mon, 28 Sep 2026 07:46:46 GMT</pubDate>
            <sparkle:version>202609281546</sparkle:version>
            <sparkle:shortVersionString>0.2.8</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>15.0</sparkle:minimumSystemVersion>
            <description><![CDATA[<p>Fixes a crash in setup&#x27;s microphone step on Macs whose microphones run at different sample rates (for example a Mac mini with a USB mic or AirPods). If a microphone still can&#x27;t be opened, Driftflow now says so instead of quitting.</p>]]></description>
            <enclosure url="https://github.com/10vr/driftflow/releases/download/v0.2.8/Driftflow-0.2.8-macOS.zip" type="application/octet-stream" sparkle:edSignature="HykcJuFvES/uXtfacLIGVumaHar9H4AYSF6P3M5xjJHY0NtWjWufOdSy0OX17eNenXa+Nt1TdzYmKahRD1tOBg==" length="13376326"/>
        </item>
        <item>
            <title>Driftflow 0.2.7</title>
            <pubDate>Mon, 28 Sep 2026 07:39:29 GMT</pubDate>
            <sparkle:version>202609281539</sparkle:version>
            <sparkle:shortVersionString>0.2.7</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>15.0</sparkle:minimumSystemVersion>
            <description><![CDATA[<p>The Settings window&#x27;s close, minimise and zoom buttons now sit inside the sidebar, like other macOS apps.</p><p>Moving between setup steps no longer slides the old step across the window or overlaps the titles.</p>]]></description>
            <enclosure url="https://github.com/10vr/driftflow/releases/download/v0.2.7/Driftflow-0.2.7-macOS.zip" type="application/octet-stream" sparkle:edSignature="YuHSlxctFZ79VLjnQtZkXT5Nlf/h7VTF4EsZvLySkh6DRkfXSbW5CUfWopY1eUiuA2QicdCpdsAEEkDK1AgXCw==" length="13375461"/>
        </item>
        <item>
            <title>Driftflow 0.2.6</title>
            <pubDate>Mon, 28 Sep 2026 07:29:49 GMT</pubDate>
            <sparkle:version>202609281529</sparkle:version>
            <sparkle:shortVersionString>0.2.6</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>15.0</sparkle:minimumSystemVersion>
            <description><![CDATA[<p>Saying &quot;drift flow&quot; (or Drift-Flow, DriftFlow) is now always written Driftflow.</p><p>New Copy Log for Support, in the menu and in Settings, to send us what happened when something goes wrong. What you dictate is never in the log.</p><p>The setup and Settings windows can be minimised, zoomed and resized, and the setup window&#x27;s buttons sit where you&#x27;d expect.</p>]]></description>
            <enclosure url="https://github.com/10vr/driftflow/releases/download/v0.2.6/Driftflow-0.2.6-macOS.zip" type="application/octet-stream" sparkle:edSignature="Y9qsU2oWsF7UiqADln0Q/WX0/E0Ky0o+Hlo3uqFPoLwLYApzWHu5eILia+1TtKoeUVsw/XE0Q+91QwYLx+ojAQ==" length="13369827"/>
        </item>
        <item>
            <title>Driftflow 0.2.0</title>
            <pubDate>Mon, 28 Sep 2026 05:37:36 GMT</pubDate>
            <sparkle:version>202609281337</sparkle:version>
            <sparkle:shortVersionString>0.2.0</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>15.0</sparkle:minimumSystemVersion>
            <description><![CDATA[<p>The first public release of Driftflow for Mac: on-device dictation for Apple Silicon Macs (macOS 15 or later).</p><p>Hold Right ⌘ to dictate and release to insert; tap it once for hands-free. Nothing leaves your Mac.</p><p>From this version on, Driftflow updates itself.</p>]]></description>
            <enclosure url="https://github.com/10vr/driftflow/releases/download/mac-v0.2.0/Driftflow-0.2.0.zip" type="application/octet-stream" sparkle:edSignature="/vIqPXtxnrThuQgC0cyncxWbylSGak0zudXad8bXFimGA+YxOadfzBxb4KAjDYWhX0jYfClH0s5132kFIaRKCQ==" length="13349461"/>
